ANTHROPIC_API_KEY=
HUBSPOT_TOKEN=
PDL_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SERPAPI_KEY=
GITHUB_TOKEN=
# GDELT + website scrape need no key. Leave any blank -> that source uses fixtures.

# Demo mode: with a HUBSPOT_TOKEN set, still read contacts + engagement from the
# local DB / domain fixtures (so the demo scores hold), while sync and write-back
# use the live token. Set to 1 for the showcase.
LEAD_LEDGER_DEMO=

# Set to 1 to let the keyless tools (GDELT, tech-stack scrape, GitHub) hit the
# live web instead of fixtures. Off keeps runs deterministic.
LEAD_LEDGER_LIVE_TOOLS=
